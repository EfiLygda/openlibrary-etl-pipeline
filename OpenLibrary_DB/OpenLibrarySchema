Table authors.works {
  author_key varchar [pk, ref: > authors.author_key]
  work_key varchar [pk, ref: > works.work_key]
}

table works.subjects{
  work_key varchar [pk, ref: > works.work_key]
  subject varchar [pk]
}

table works.people{
  work_key varchar [pk, ref: > works.work_key]
  person varchar [pk]
}

table works.places{
  work_key varchar [pk, ref: > works.work_key]
  place varchar [pk]
}

table works.time_periods{
  work_key varchar [pk, ref: > works.work_key]
  time_period varchar [pk]
}

table works.series{
  work_key varchar [primary key, ref: > works.work_key]
  series_key varchar
  series_position int
  name varchar
}

table works.availability{
  work_key varchar [primary key, ref: > works.work_key]
  ebook_access varchar
  has_fulltext bool
  has_public_scan bool
}

table author.statistics{
  author_key varchar [primary key, ref: > authors.author_key]
  top_work varchar
  work_count int
  ratings_count_1 int
  ratings_count_2 int
  ratings_count_3 int
  ratings_count_4 int
  ratings_count_5 int
  readinglog_count int
  want_to_read_count int
  currently_reading_count int
  already_read_count int
}

Table authors.alternative_names {
  author_key varchar [pk, ref: > authors.author_key]
  author_alternative_name varchar [pk]
}

table editions.contributors {
  edition_key varchar [pk, ref: > editions.edition_key]
  contributor_name varchar [pk]
  contributor_role varchar [pk]
  by_statement varchar
  translated_from varchar
  translation_of varchar
}

table editions.publishing {
  edition_key varchar [pk, ref: > editions.edition_key]
  publish_date date
  publisher_name varchar
  publish_place varchar
  publish_country varchar
  series_title varchar
}

table editions.contents {
  edition_key varchar [pk, ref: > editions.edition_key]
  description varchar
  notes varchar
  first_sentence varchar
}

table editions.details {
  edition_key varchar [pk, ref: > editions.edition_key]
  number_of_pages int
  physical_format varchar
  physical_dimensions varchar
  weight varchar
  language varchar
}
