Table works {
  work_key varchar [pk]
  title varchar
  subtitle varchar
  description TEXT
  first_sentence TEXT
  edition_count int
  first_publish_year int
  first_publish_date date
}

Table authors {
  author_key varchar [pk]
  author_name varchar
  bio varchar
  birth_date varchar
  death_date varchar
  birth_year int
  death_year int
}

Table editions {
  edition_key varchar [pk]
  work_key varchar [ref: > works.work_key]
  title varchar
  subtitle varchar
  edition_name varchar
}

